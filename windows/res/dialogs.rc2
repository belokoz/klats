// Dialog layouts in dialog units. The texts come from strings.cpp at run time, in Russian or
// English, so the templates carry none. Included by klats.rc after its code page pragma.

IDD_SETTINGS DIALOGEX 0, 0, 300, 338
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Klats"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_HOTKEYS_HEADER, 12, 10, 276, 10
    LTEXT           "", IDC_LAYOUT_LABEL, 20, 28, 132, 10
    CONTROL         "", IDC_LAYOUT_HOTKEY, "Button", BS_OWNERDRAW | WS_TABSTOP, 156, 24, 112, 18
    PUSHBUTTON      "", IDC_LAYOUT_RESET, 272, 24, 18, 18
    LTEXT           "", IDC_CASE_LABEL, 20, 50, 132, 10
    CONTROL         "", IDC_CASE_HOTKEY, "Button", BS_OWNERDRAW | WS_TABSTOP, 156, 46, 112, 18
    PUSHBUTTON      "", IDC_CASE_RESET, 272, 46, 18, 18
    LTEXT           "", IDC_HOTKEYS_NOTE, 20, 70, 270, 26
    LTEXT           "", IDC_HOTKEY_ERROR, 20, 98, 270, 10

    LTEXT           "", IDC_LAYOUT_HEADER, 12, 116, 276, 10
    LTEXT           "", IDC_PAIR_LABEL, 20, 134, 132, 10
    LTEXT           "", IDC_PAIR_TEXT, 156, 134, 134, 10
    COMBOBOX        IDC_FIRST_LAYOUT, 156, 132, 134, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_SECOND_LABEL, 20, 152, 132, 10
    COMBOBOX        IDC_SECOND_LAYOUT, 156, 150, 134, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "", IDC_SWITCH_LAYOUT, 20, 170, 270, 12, WS_TABSTOP

    LTEXT           "", IDC_CASE_HEADER, 12, 190, 276, 10
    AUTORADIOBUTTON "", IDC_CASE_INVERT, 20, 206, 132, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "", IDC_CASE_LOWER, 20, 222, 132, 12
    LTEXT           "", IDC_CASE_INVERT_EXAMPLE, 156, 207, 134, 10, WS_GROUP
    LTEXT           "", IDC_CASE_LOWER_EXAMPLE, 156, 223, 134, 10

    LTEXT           "", IDC_GENERAL_HEADER, 12, 242, 276, 10
    AUTOCHECKBOX    "", IDC_AUTOSTART, 20, 258, 270, 12, WS_GROUP | WS_TABSTOP
    LTEXT           "", IDC_AUTOSTART_NOTE, 32, 271, 258, 10
    AUTOCHECKBOX    "", IDC_CHECK_UPDATES, 20, 284, 270, 12, WS_TABSTOP

    CONTROL         "", IDC_FOOTER_REPO, "SysLink", WS_TABSTOP, 20, 306, 270, 10
    CONTROL         "", IDC_FOOTER_DIKTUY, "SysLink", WS_TABSTOP, 20, 320, 270, 10
END

IDD_ONBOARDING DIALOGEX 0, 0, 300, 262
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Klats"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_OB_ICON, "Static", SS_ICON | SS_REALSIZEIMAGE, 12, 10, 32, 32
    LTEXT           "", IDC_OB_TITLE, 52, 10, 236, 16
    LTEXT           "", IDC_OB_SUBTITLE, 52, 28, 236, 10

    LTEXT           "", IDC_OB_TRY_HEADER, 12, 52, 276, 10
    LTEXT           "", IDC_OB_TRY_TEXT, 20, 66, 268, 10
    EDITTEXT        IDC_OB_PROBE, 20, 80, 268, 16, ES_AUTOHSCROLL
    LTEXT           "", IDC_OB_TRY_RESULT, 20, 100, 268, 18

    LTEXT           "", IDC_OB_WHERE_HEADER, 12, 124, 276, 10
    LTEXT           "", IDC_OB_WHERE_TEXT, 20, 138, 268, 28
    PUSHBUTTON      "", IDC_OB_TASKBAR, 20, 168, 140, 16

    AUTOCHECKBOX    "", IDC_OB_AUTOSTART, 12, 196, 276, 12, WS_TABSTOP
    LTEXT           "", IDC_OB_ADMIN_NOTE, 12, 212, 276, 18
    DEFPUSHBUTTON   "", IDOK, 228, 240, 60, 16
END
